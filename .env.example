# API
EA_ENVIRONMENT=development
EA_DATABASE_URL=postgresql+asyncpg://accreditation:accreditation@localhost:5432/accreditation
EA_REDIS_URL=redis://localhost:6379/0
EA_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
EA_OBJECT_STORAGE_ACCESS_KEY=local-development
EA_OBJECT_STORAGE_SECRET_KEY=replace-in-local-env
EA_OBJECT_STORAGE_BUCKET=engineering-accreditation
EA_CORS_ORIGINS=["http://localhost:5173"]

# 本地优先材料流水线
EA_LOCAL_DATA_DIR=.local-data
EA_MAX_UPLOAD_BYTES=52428800
EA_VIRUS_SCAN_MODE=auto
EA_CLAMAV_COMMAND=clamscan

# M6：仅用于无个人明细的本地试点汇总批次，默认关闭
EA_ENABLE_PILOT_SCORE_BATCH_CAPTURE=false

# DeepSeek：通用 API 用于结构化；DeepSeek-OCR 端点用于图片/扫描 PDF
EA_DEEPSEEK_API_BASE_URL=https://api.deepseek.com
EA_DEEPSEEK_API_KEY=
EA_DEEPSEEK_MODEL=deepseek-v4-flash
EA_DEEPSEEK_OCR_BASE_URL=http://localhost:8001/v1
EA_DEEPSEEK_OCR_API_KEY=
EA_DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR
EA_DEEPSEEK_TIMEOUT_SECONDS=60
EA_OCR_MAX_PDF_PAGES=12

# Worker
EA_CELERY_BROKER_URL=redis://localhost:6379/0
EA_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Web：留空表示通过当前域名访问 /api
VITE_API_BASE_URL=
