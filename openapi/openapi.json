      "post": {
        "tags": [
          "teaching-graph"
        ],
        "summary": "校验并发布不可变能力图谱快照",
        "operationId": "publish_workspace_api_v1_teaching_graph_workspace_publish_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphRevisionCommandRequest"
              }
            }
          },
          "required": true
