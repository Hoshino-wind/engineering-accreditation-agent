    "/api/v1/system/status": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "获取系统状态",
        "operationId": "get_system_status_api_v1_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/materials": {
      "get": {
        "tags": [
          "materials"
        ],
        "summary": "列出本地教学材料",
        "operationId": "list_materials_api_v1_materials_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "materials"
        ],
        "summary": "上传教学材料并进入本地处理流水线",
        "operationId": "upload_material_api_v1_materials_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_material_api_v1_materials_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/materials/{material_id}": {
      "get": {
        "tags": [
          "materials"
        ],
        "summary": "获取材料处理详情",
        "operationId": "get_material_api_v1_materials__material_id__get",
        "parameters": [
          {
            "name": "material_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Material Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/materials/{material_id}/retry": {
      "post": {
        "tags": [
          "materials"
        ],
        "summary": "重试材料解析流水线",
