          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/teaching-graph/audit-events": {
      "get": {
        "tags": [
          "teaching-graph"
        ],
        "summary": "列出能力图谱追加审计事件",
        "operationId": "list_audit_events_api_v1_teaching_graph_audit_events_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
